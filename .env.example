#===========================================================================================
# Jolie backend — environment configuration
#
# Copy to `.env` and fill in the blanks:   cp .env.example .env
#
# ONE .env file serves both ways of running the backend:
#   * Locally (npm run dev, prisma CLI, scripts)  -> uses the values below as written
#                                                     (localhost + HOST ports).
#   * Inside Docker Compose                       -> docker-compose.yml OVERRIDES
#                                                     DATABASE_URL / AI_DATABASE_URL /
#                                                     REDIS_HOST / REDIS_PORT with the
#                                                     service names `postgres` / `redis`
#                                                     and the internal ports 5432 / 6379.
#
# Keep comments on their own lines. Docker Compose does not strip a trailing `# comment`
# after an empty value (KEY=   # comment  becomes the literal value "# comment").
#===========================================================================================

# development | production | test
NODE_ENV=development
# Port the HTTP server listens on (same inside and outside Docker)
BACKEND_PORT=4000

#===========================================================================================
# PostgreSQL (Docker Compose service `postgres`, image pgvector/pgvector:pg17)
#
# The container is initialised from these values the FIRST time its volume is created.
# Changing them later has no effect until the volume is recreated
# (docker compose down -v). Use a URL-safe password (letters, digits, - _ . ~).
#===========================================================================================

POSTGRES_USER=jolie
POSTGRES_PASSWORD=change-me
# Application database (Prisma migrations + seed)
POSTGRES_DB=jolie_app
# Separate database for AI / pgvector experiments (created with the `vector` extension)
POSTGRES_AI_DB=jolie_ai
# Port published on the host (127.0.0.1). Inside Docker the port is always 5432.
POSTGRES_HOST_PORT=5435

# Application database — used by Prisma (prisma.config.ts) and src/prisma.ts.
# Local value: localhost + POSTGRES_HOST_PORT. Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://jolie:change-me@localhost:5435/jolie_app

# AI / pgvector experiments database — used ONLY by AI scripts (src/scripts/*).
# Never point this at the application database.
AI_DATABASE_URL=postgresql://jolie:change-me@localhost:5435/jolie_ai

# For a hosted database (Supabase/Render) set DATABASE_URL to the provider's URL instead.

#===========================================================================================
# Redis (Docker Compose service `redis`)
#===========================================================================================

# Local value: localhost + REDIS_HOST_PORT. In Docker: redis:6379 (set by compose).
REDIS_HOST=localhost
REDIS_PORT=6380
# Port published on the host (127.0.0.1). Inside Docker the port is always 6379.
REDIS_HOST_PORT=6380
# Optional — leave empty for the default user
REDIS_USERNAME=
# Optional — leave empty for no password (the Docker Redis uses the same value)
REDIS_PASSWORD=
REDIS_DB=0
# Default cache TTL in seconds
REDIS_CACHE_TTL=300

#===========================================================================================
# JWT
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#===========================================================================================

JWT_ACCESS_SECRET=
# ms/s/m/h/d format
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

#===========================================================================================
# CORS (comma-separated list of allowed origins)
#===========================================================================================

CORS_ORIGIN=http://localhost:3000

#===========================================================================================
# Cloudinary (image uploads)
#===========================================================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

#===========================================================================================
# SMTP (email) — Ethereal is fine for development
#===========================================================================================

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional — falls back to SMTP_USER
SMTP_FROM=

#===========================================================================================
# Google OAuth
#===========================================================================================

GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
# Where the frontend lives (callback redirect)
FRONTEND_URL=http://localhost:3000
# Backend's own public URL (OAuth redirect URI)
APP_URL=http://localhost:4000

#===========================================================================================
# Logging
#===========================================================================================

# true = pino-pretty (dev), false = JSON (prod)
LOG_PRETTY=true
# trace | debug | info | warn | error
LOG_LEVEL=debug

#===========================================================================================
# Ollama (AI experiments, runs on the host — not in Docker)
#===========================================================================================

OLLAMA_HOST=http://localhost:11434
